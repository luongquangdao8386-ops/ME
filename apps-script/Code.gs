REF_CODE_COL_.Meters = 'meter_code';
REF_CODE_COL_.Panels = 'panel_code';
REF_CODE_COL_.Circuits = 'circuit_code';

/** Danh mục mã thêm trong mẫu: đồng hồ, tủ, lộ (mã · tên) */
function importTemplateListsD3_(t, addList) {
  var pick = function (sheet, code) {
    return readRows_(sheet).filter(function (r) { return !r.archived_at && r.active !== false; }).map(function (r) { return [r[code], r.name_vi || r.name_zh]; })
      .sort(function (a, b) { return String(a[0]).localeCompare(String(b[0])); });
  };
  if (t.module === 'utilities') addList('meters', pick('Meters', 'meter_code'));
  if (t.module === 'circuits') { addList('panels', pick('Panels', 'panel_code')); addList('circuits', pick('Circuits', 'circuit_code')); }
}

/** Mẫu Đợt 3 cần quyền riêng ngoài cờ Nhập của module (biểu giá: quyền lập biểu giá) */
function assertImportTemplateUse_(ctx, t, forExport) {
  var a = forExport ? (t.exportRequires || t.requires) : t.requires;
  if (a && !can_(ctx, a, { module: t.module })) throw apiError_('FORBIDDEN');
}

function numOk_(v, min, max) { return v === undefined || v === '' || (Number(v) >= min && Number(v) <= max); }

/** Kiểm thêm theo dòng (lượt 2, đã có tham chiếu). st: trạng thái dùng chung của cả lô (chỉ số trùng trong file) */
function importRowCheckD3_(x, st) {
  if (!x.sh) return;
  var v = x.vals, cur = x.cur || {};
  var val = function (f) { return v[f] !== undefined ? v[f] : cur[f]; };
  var nowMs = now_().getTime() + 5 * 60000;
  var future = function (f) { var t0 = v[f] ? parseTime_(v[f]) : null; return !!t0 && t0.getTime() > nowMs; };
  switch (x.sh.table) {
    case 'Meters':
      if (x.action === 'UPDATE') {
        ['opening_value', 'opening_at'].forEach(function (f) { if (v[f] !== undefined && v[f] !== '') x.errs.push([f, 'INVALID_VALUE']); });
      } else {
        if (v.opening_at && (v.opening_value === undefined || v.opening_value === '')) x.errs.push(['opening_value', 'REQUIRED']);
        if (!numOk_(v.opening_value, 0, 1e12)) x.errs.push(['opening_value', 'INVALID_VALUE']);
        if (future('opening_at')) x.errs.push(['opening_at', 'TIME_ORDER_INVALID']);
      }
      if (v.multiplier !== undefined && v.multiplier !== '' && !(Number(v.multiplier) > 0 && Number(v.multiplier) <= 1e6)) x.errs.push(['multiplier', 'INVALID_VALUE']);
      break;
    case 'MeterReadings': {
      if (!numOk_(v.cumulative_value, 0, 1e12)) x.errs.push(['cumulative_value', 'INVALID_VALUE']);
      if (future('measured_at')) x.errs.push(['measured_at', 'TIME_ORDER_INVALID']);
      var mid = x.refs.meter_id;
      var t1 = v.measured_at ? parseTime_(v.measured_at) : null;
      if (!mid || !t1) break;
      var m = readRowsCached_('Meters').filter(function (r) { return r.meter_id === mid; })[0];
      if (m && (m.active === false || m.archived_at)) x.errs.push(['meter_key', 'METER_INACTIVE']);
      var k = mid + '|' + t1.getTime();
      st.readings = st.readings || {};
      var dup = st.readings[k] || readRowsCached_('MeterReadings').some(function (r) {
        if (r.meter_id !== mid || r.status === 'VOID') return false;
        var t2 = parseTime_(r.measured_at);
        return !!t2 && t2.getTime() === t1.getTime();
      });
      if (dup) x.errs.push(['measured_at', 'READING_DUPLICATE']);
      st.readings[k] = true;
      break;
    }
    case 'UtilityTariffs': {
      var a = val('effective_from'), b = val('effective_to');
      if (a && b && b < a) x.errs.push(['effective_to', 'INVALID_DATE']);
      if (!numOk_(v.unit_price, 0, 1e12)) x.errs.push(['unit_price', 'INVALID_VALUE']);
      if (!numOk_(v.tax_rate, 0, 100)) x.errs.push(['tax_rate', 'INVALID_VALUE']);
      if (v.currency && !/^[A-Z]{3}$/.test(String(v.currency))) x.errs.push(['currency', 'INVALID_VALUE']);
      // Biểu giá đã duyệt/ngừng không sửa qua Excel (đổi giá = thêm biểu giá mới); dòng xuất ra nhập lại nguyên trạng thì bỏ qua
      if (x.action === 'UPDATE' && cur.status !== 'DRAFT' && cur.status !== 'REJECTED' &&
        !importRowUnchanged_(x.sh, { action: 'UPDATE', entity_id: x.entityId, normalized_payload_json: { v: v, r: x.refs } }, cur)) x.errs.push(['tariff_id', 'STATUS_INVALID']);
      break;
    }
    case 'Panels':
      ['supply_voltage', 'rated_current'].forEach(function (f) { if (!numOk_(v[f], 0, 1e9)) x.errs.push([f, 'INVALID_VALUE']); });
      break;
    case 'Circuits':
      if (v.phases !== undefined && v.phases !== '' && [1, 2, 3].indexOf(Number(v.phases)) < 0) x.errs.push(['phases', 'INVALID_VALUE']);
      ['voltage', 'breaker_rating_a', 'cable_length_m'].forEach(function (f) { if (!numOk_(v[f], 0, 1e9)) x.errs.push([f, 'INVALID_VALUE']); });
      break;
    case 'CircuitLoads': {
      if (!numOk_(v.rated_load_kw, 0, 1e9)) x.errs.push(['rated_load_kw', 'INVALID_VALUE']);
      var eq = x.refs.equipment_id !== undefined ? x.refs.equipment_id : cur.equipment_id;
      var dp = x.refs.downstream_panel_id !== undefined ? x.refs.downstream_panel_id : cur.downstream_panel_id;
      if (!!eq === !!dp && !x.errs.some(function (e) { return e[0] === 'equipment_code' || e[0] === 'downstream_panel_key'; })) x.errs.push(['equipment_code', 'LOAD_TARGET_ONE']);
      break;
    }
    case 'Documents':
      if (!!x.refs.panel_id === !!x.refs.circuit_id && !x.errs.some(function (e) { return e[0] === 'panel_key' || e[0] === 'circuit_key'; })) x.errs.push(['panel_key', 'DRAWING_TARGET_ONE']);
      if (v.external_url && !/^https:\/\/[^\s<>"]{3,2000}$/.test(String(v.external_url))) x.errs.push(['external_url', 'URL_INVALID']);
      break;
  }
}

/** Người chạy thao tác của dòng: người nhập nếu có quyền đó (người đọc chỉ số, người tải bản vẽ), không thì người commit */
function importActor_(ctx, importer, action, module) {
  if (!importer || importer.user_id === ctx.user.user_id) return null;
  var sub = { user: importer, req: { payload: {} } };
  try { return can_(sub, action, { module: module }) ? importer : null; } catch (e) { return null; }
}

/** Ghi một dòng của mẫu Đợt 3; undefined = không phải bảng Đợt 3 */
function commitImportRowD3_(ctx, b, sh, r, importer, run, p, ev, add) {
  switch (sh.table) {
    case 'Meters':
      if (p.active === false) p.reason = 'Excel ' + b.import_batch_id.slice(0, 8);
      if (!add) { delete p.opening_value; delete p.opening_at; delete p.utility_type; }
      return run('meter.edit', p, r.import_row_id, ev);
    case 'MeterReadings':
      return run('reading.create', p, r.import_row_id, 0, importActor_(ctx, importer, 'reading.create', 'utilities'));
    case 'UtilityTariffs': {
      // Người nhập lập/sửa nháp; người commit duyệt (commit lô nhạy cảm là duyệt)
      delete p.status;
      run('tariff.edit', p, r.import_row_id, ev, importer);
      var tf = findOne_('UtilityTariffs', 'tariff_id', r.entity_id);
      if (tf && tf.status === 'DRAFT') run('tariff.approve', { tariff_id: r.entity_id, decision: 'APPROVE' }, uuidFrom_(r.import_row_id + ':approve'), tf.record_version);
      return true;
    }
    case 'Panels': p.entity = 'PANEL'; return run('circuit.edit', p, r.import_row_id, ev);
    case 'Circuits': p.entity = 'CIRCUIT'; return run('circuit.edit', p, r.import_row_id, ev);
    case 'CircuitLoads': p.entity = 'LOAD'; if (!add) delete p.circuit_id; return run('circuit.edit', p, r.import_row_id, ev);
    case 'Documents': {
      var q = {
        document_id: r.entity_id, entity_type: p.panel_id ? 'PANEL' : 'CIRCUIT', entity_id: p.panel_id || p.circuit_id,
        external_url: p.external_url, title_vi: p.title_vi, title_zh: p.title_zh, document_date: p.document_date
      };
      return run('circuit.drawing.upload', q, r.import_row_id, 0, importActor_(ctx, importer, 'circuit.drawing.upload', 'circuits'));
    }
  }
  return undefined;
}

// ===== 34_reset.js =====
/* 34_reset: Xóa sạch dữ liệu vận hành (Đợt 4) — 1.4 §21, phụ lục 1.5 mục 6.9.3, 2.6, 2.8, 3.8, 3.14, 4.4.16.
 *
 * system.reset.preview → owner xem số bản ghi/file máy chủ đếm, nhận nonce + plan_hash (10 phút).
 * system.reset.request → PIN nhập ngay trong request + nonce + plan_hash + gõ đúng "XÓA TOÀN BỘ" + chế độ file:
 *   bật bảo trì, ResetRuns LOCKED, cấp phiên phục hồi (RECOVERY, 30 phút) cho owner, cài trigger resetContinue.
 * Chạy theo lô có điểm dừng (phase/cursor lưu trong ResetRuns): BACKUP → EPOCH → FILES_BUILD → FILES → TABLES → SCOPES → VERIFY.
 *   Owner đang xem tiến độ (system.reset.status) và trigger mỗi phút cùng đẩy, mỗi lúc một nơi (lease trong ScriptProperties).
 *   Lỗi → FAILED_NEEDS_RECOVERY, giữ bảo trì; system.reset.resume (PIN) tiếp tục đúng reset_run_id, hoặc hủy khi chưa xóa gì.
 * Không chép ảnh/tài liệu vào bản sao lưu (6.5.4): chế độ "Xóa vĩnh viễn" không hoàn tác được, màn xác nhận nói rõ. */

var RESET_CONFIRM_TEXT_ = 'XÓA TOÀN BỘ';
var RESET_PREVIEW_MINUTES_ = 10;
var RESET_FILE_MODES_ = ['KEEP', 'TRASH', 'DELETE'];
var RESET_ACTIVE_ = { LOCKED: 1, BACKING_UP: 1, RESETTING: 1, VERIFYING: 1 };
/** Một lần system.reset.status đẩy tối đa ~20 giây (app hỏi lại sau 5 giây); trigger chạy tới ~4 phút */
var RESET_STEP_BUDGET_MS_ = 20000;
var RESET_TRIGGER_BUDGET_MS_ = 240000;
var RESET_LEASE_PROP_ = 'RESET_LEASE';

/**
 * Nhóm và bảng bị xóa (1.4 §21.2). Thứ tự trong nhóm: bảng con trước. Documents (metadata) xóa sau cùng, sau khi đã xử lý file.
 * Giữ lại: Settings, SystemState, Glossary (từ điển thuật ngữ), NotificationRecipients (người nhận Gmail; phạm vi cũ tắt),
 * Users/RolePermissions/UserScopes (phạm vi khu vực tắt), Sessions (thu hồi), AuthAttempts, ResetRuns/ResetFiles.
 */
var RESET_GROUPS_ = [
  { key: 'catalog', tables: ['EquipmentParts', 'EquipmentSpecs', 'Equipment', 'Materials', 'InspectionTypes', 'Vendors', 'LookupValues', 'Locations'] },
  { key: 'work', tables: ['AnnualPlans', 'WorkOrderResults', 'WorkOrders', 'MaintenancePlans', 'ChecklistTemplates', 'RepairTasks', 'Repairs',
    'MaterialRequestLines', 'MaterialRequests', 'MaterialUsageLines', 'OperatingReadings', 'EquipmentPartEvents'] },
  { key: 'utilities', tables: ['MeterReadings', 'MeterEvents', 'MeterSegments', 'Meters', 'UtilityTariffs', 'CircuitLoads', 'Circuits', 'Panels'] },
  { key: 'contracts', tables: ['ContractServices', 'ContractEquipment', 'Contracts', 'Inspections', 'InspectionRequirements'] },
  { key: 'reports', tables: ['ReportRuns', 'ReportDefinitions', 'ImportRows', 'ImportBatches', 'Operations', 'AuditLogs'] },
  { key: 'alerts', tables: ['Alerts', 'NotificationLogs'] },
  { key: 'qr', tables: ['QrRegistry'] },
  { key: 'documents', tables: ['Documents'] }
];

/** Nhật ký giữ lại: tài khoản, quyền, cấu hình, sao lưu, hệ thống (không phải nhật ký nghiệp vụ) */
var RESET_AUDIT_KEEP_RE_ = /^(auth|pin|session|user|permission|settings|notify\.settings|notify\.recipient|backup|system|audit)\./;

function resetAuditKept_(a) { return RESET_AUDIT_KEEP_RE_.test(String(a.action || '')); }

/** Bảng của nhóm đã có trong dữ liệu (đợt ≤ đợt đang chạy: dán Code.gs mới mà chưa migrateSchema thì bỏ bảng chưa tạo) */
function resetTables_(g) {
  var dot = releasedDot_();
  return g.tables.filter(function (t) { return !SHEETS[t] || SHEETS[t].dot <= dot; });
}

function resetTableOrder_() {
  var out = [];
  RESET_GROUPS_.forEach(function (g) { resetTables_(g).forEach(function (t) { out.push({ table: t, group: g.key }); }); });
  return out;
}

/** Số dòng sẽ xóa của một bảng */
function resetTableCount_(name) {
  if (name === 'AuditLogs') return readRows_('AuditLogs').filter(function (a) { return !resetAuditKept_(a); }).length;
  if (name === 'ReportDefinitions') return readRows_('ReportDefinitions').filter(function (d) { return !d.builtin; }).length;
  return Math.max(0, sh_(name).getLastRow() - 1);
}

/** Danh sách file app quản lý lập từ metadata (Documents): file chính và ảnh nhỏ. Thư mục dữ liệu chung không đụng tới. */
function resetFileEntries_() {
  var out = [], external = 0;
  readRows_('Documents').forEach(function (d) {
    if (!d.owned_by_app || !d.drive_file_id) { external++; return; }
    var shared = d.drive_sharing_state === 'LINK_SHARED';
    out.push({ drive_file_id: String(d.drive_file_id), source_document_id: d.document_id, file_kind: 'MAIN', shared: shared });
    if (d.thumb_drive_file_id) out.push({ drive_file_id: String(d.thumb_drive_file_id), source_document_id: d.document_id, file_kind: 'THUMB', shared: shared });
  });
  return { list: out, external: external };
}

/** Kế hoạch (máy chủ đếm, không dựa số client tự khai): {epoch, groups:{key:n}, files:{app, shared, external}} */
function resetPlan_() {
  var groups = {};
  RESET_GROUPS_.forEach(function (g) {
    var n = 0;
    resetTables_(g).forEach(function (t) { n += resetTableCount_(t); });
    groups[g.key] = n;
  });
  var fe = resetFileEntries_();
  return {
    epoch: sysProps_().dataset_epoch, groups: groups,
    files: { app: fe.list.length, shared: fe.list.filter(function (f) { return f.shared; }).length, external: fe.external }
  };
}

function resetPlanHash_(plan) { return b64url_(sha256_(JSON.stringify(plan))); }

/** Xóa vĩnh viễn cần dịch vụ nâng cao Drive API (Dịch vụ → Drive API); DriveApp chỉ đưa vào thùng rác (1.4 §21.3) */
function resetDeleteAvailable_() {
  try { return typeof Drive !== 'undefined' && !!Drive && !!Drive.Files && typeof Drive.Files.remove === 'function'; } catch (e) { return false; }
}

function resetRunRow_(id) { return id ? findOne_('ResetRuns', 'reset_run_id', id) : null; }

/** Đợt đang chạy hoặc đang chờ xử lý lỗi (chỉ một đợt một lúc) */
function resetOpenRun_() {
  var rows = readRows_('ResetRuns').filter(function (r) { return RESET_ACTIVE_[r.status] || r.status === 'FAILED_NEEDS_RECOVERY'; });
  rows.sort(function (a, b) { return String(a.requested_at) < String(b.requested_at) ? 1 : -1; });
  return rows[0] || null;
}

function resetStatusForPhase_(phase) {
  if (phase === 'BACKUP') return 'BACKING_UP';
  if (phase === 'VERIFY') return 'VERIFYING';
  return 'RESETTING';
}

function resetJson_(v, def) {
  if (v && typeof v === 'object') return v;
  if (typeof v === 'string' && v) { try { return JSON.parse(v); } catch (e) { return def; } }
  return def;
}

function resetSave_(run, fields) {
  fields.updated_at = isoVN_(now_());
  Object.keys(fields).forEach(function (k) {
    if (fields[k] && typeof fields[k] === 'object') fields[k] = JSON.stringify(fields[k]);
  });
  withWriteLock_(function () { writeCells_('ResetRuns', run.__row, fields); });
  Object.keys(fields).forEach(function (k) { run[k] = fields[k]; });
}

/** Lỗi có mã để ghi error_code */
function resetError_(code, detail) {
  var e = new Error(code + (detail ? ': ' + detail : ''));
  e.resetCode = code;
  e.resetDetail = detail || '';
  return e;
}

/* ---------------- Lease: mỗi lúc chỉ một nơi đẩy đợt (trigger hoặc request tiến độ) ---------------- */

function acquireResetLease_(runId, ms) {
  return withWriteLock_(function () {
    var props = PropertiesService.getScriptProperties();
    var cur = null;
    try { cur = JSON.parse(props.getProperty(RESET_LEASE_PROP_) || 'null'); } catch (e) { cur = null; }
    var t = now_().getTime();
    if (cur && cur.until > t) return false;
    props.setProperty(RESET_LEASE_PROP_, JSON.stringify({ run: runId, until: t + ms }));
    return true;
  });
}

function releaseResetLease_() {
  try { PropertiesService.getScriptProperties().deleteProperty(RESET_LEASE_PROP_); } catch (e) { /* hết hạn tự nhả */ }
}

function resetLeaseBusy_() {
  var cur = null;
  try { cur = JSON.parse(PropertiesService.getScriptProperties().getProperty(RESET_LEASE_PROP_) || 'null'); } catch (e) { cur = null; }
  return !!cur && cur.until > now_().getTime();
}

/* ---------------- Trigger tiếp tục ---------------- */

function installResetTrigger_() {
  var has = ScriptApp.getProjectTriggers().some(function (t) { return t.getHandlerFunction() === 'resetContinue'; });
  if (!has) ScriptApp.newTrigger('resetContinue').timeBased().everyMinutes(1).create();
}

function removeResetTrigger_() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'resetContinue') ScriptApp.deleteTrigger(t); });
}

/** Trigger mỗi phút trong lúc có đợt Xóa sạch đang chạy (tự gỡ khi xong hoặc lỗi) */
function resetContinue() {
  var t0 = Date.now();
  try {
    dbReset_();
    var run = resetOpenRun_();
    if (!run || !RESET_ACTIVE_[run.status]) { removeResetTrigger_(); return; }
    advanceReset_(run.reset_run_id, RESET_TRIGGER_BUDGET_MS_);
  } finally { recordTriggerRun_('resetContinue', t0); }
}

/* ---------------- Chạy đợt theo lô ---------------- */

/** Đẩy đợt tối đa budgetMs. Trả false nếu nơi khác đang đẩy. */
function advanceReset_(runId, budgetMs) {
  var t0 = now_().getTime();
  if (!acquireResetLease_(runId, budgetMs + 120000)) return false;
  try {
    for (var i = 0; i < 500; i++) {
      var run = resetRunRow_(runId);
      if (!run || !RESET_ACTIVE_[run.status]) break;
      if (now_().getTime() - t0 > budgetMs) break;
      try {
        resetStep_(run, t0, budgetMs);
      } catch (e) {
        resetFail_(run, e);
        break;
      }
    }
  } finally { releaseResetLease_(); }
  return true;
}

function resetFail_(run, e) {
  var code = e && e.resetCode ? e.resetCode : (e && e.apiCode ? e.apiCode : 'STEP_ERROR');
  var detail = e && e.resetDetail ? e.resetDetail : String(e && e.message || e);
  try {
    resetSave_(run, { status: 'FAILED_NEEDS_RECOVERY', error_code: code, error_detail: detail.slice(0, 300) });
  } catch (e2) { console.error('resetFail_ ' + e2); }
  removeResetTrigger_();
  console.error('Xóa sạch lỗi ' + run.reset_run_id + ' ' + run.phase + ' ' + code + ' ' + detail);
}

function resetProgress_(run) {
  var pr = resetJson_(run.summary_counts_json, null);
  if (pr && pr.groups) return pr;
  var plan = resetJson_(run.plan_json, { groups: {}, files: {} });
  var groups = {};
  RESET_GROUPS_.forEach(function (g) { groups[g.key] = { total: Number(plan.groups[g.key] || 0), done: 0 }; });
  return { groups: groups, files: { total: Number((plan.files || {}).app || 0), done: 0, failed: 0 } };
}

/** Một bước của đợt; ghi phase/cursor sau mỗi lô */
function resetStep_(run, t0, budgetMs) {
  var cursor = resetJson_(run.cursor_json, {});
  var pr = resetProgress_(run);
  switch (run.phase) {
    case 'BACKUP': {
      if (run.status !== 'BACKING_UP') resetSave_(run, { status: 'BACKING_UP' });
      // Sao lưu có kiểm chứng trước khi xóa (21.5 bước 4): bảo trì đang bật nên không có ghi chen giữa
      var m;
      try {
        m = backupDataRun_();
        if (m.status === 'INCONSISTENT') m = backupDataRun_();
      } catch (eb) { throw resetError_('BACKUP_FAILED', String(eb && eb.message || eb)); }
      if (m.status !== 'VERIFIED') throw resetError_('BACKUP_FAILED', m.error || m.status);
      resetSave_(run, { backup_ref: m.folder, backup_verified_at: m.finished_at, phase: 'EPOCH', status: 'RESETTING' });
      return;
    }
    case 'EPOCH':
      resetEpochPhase_(run);
      resetSave_(run, { phase: 'FILES_BUILD' });
      return;
    case 'FILES_BUILD': {
      var have = findAll_('ResetFiles', 'reset_run_id', run.reset_run_id).length;
      if (!have) {
        var fe = resetFileEntries_();
        var nowIso = isoVN_(now_());
        var rows = fe.list.map(function (f) {
          return {
            reset_file_id: uuid_(), reset_run_id: run.reset_run_id, drive_file_id: f.drive_file_id, source_document_id: f.source_document_id,
            managed_folder_id: '', owned_by_app: true, file_mode: run.file_mode, status: 'PENDING', processed_at: '', error_code: '',
            file_kind: f.file_kind, privacy_status: f.shared ? 'SHARED' : 'NOT_SHARED'
          };
        });
        withWriteLock_(function () { if (rows.length) insertRows_('ResetFiles', rows); });
        pr.files = { total: rows.length, done: 0, failed: 0 };
        pr.external = fe.external;
        resetSave_(run, { summary_counts_json: pr, cursor_json: cursor, updated_at: nowIso });
      }
      resetSave_(run, { phase: 'FILES' });
      return;
    }
    case 'FILES': {
      var pending = findAll_('ResetFiles', 'reset_run_id', run.reset_run_id).filter(function (f) { return f.status === 'PENDING'; });
      if (!pending.length) { resetSave_(run, { phase: 'TABLES', cursor_json: { table_index: 0 } }); return; }
      for (var i = 0; i < pending.length; i++) {
        if (now_().getTime() - t0 > budgetMs) break;
        var f = pending[i];
        var res = resetProcessFile_(f, run.file_mode);
        withWriteLock_(function () {
          writeCells_('ResetFiles', f.__row, { status: res.status, privacy_status: res.privacy_status, error_code: res.error_code || '', processed_at: isoVN_(now_()) });
        });
        pr.files.done++;
        if (res.status === 'FAILED') pr.files.failed++;
        // Ghi tiến độ thưa (mỗi 10 file) để không tốn lượt ghi; dừng giữa chừng thì đếm lại từ ResetFiles
        if (pr.files.done % 10 === 0) resetSave_(run, { summary_counts_json: pr });
      }
      resetSave_(run, { summary_counts_json: resetFilesRecount_(run, pr) });
      return;
    }
    case 'TABLES': {
      var order = resetTableOrder_();
      var idx = Number(cursor.table_index || 0);
      if (idx >= order.length) { resetSave_(run, { phase: 'SCOPES' }); return; }
      var item = order[idx];
      var n = resetClearTable_(item.table);
      pr.groups[item.group] = pr.groups[item.group] || { total: 0, done: 0 };
      pr.groups[item.group].done += n;
      resetSave_(run, { cursor_json: { table_index: idx + 1 }, summary_counts_json: pr });
      return;
    }
    case 'SCOPES':
      resetScopesPhase_(run);
      resetSave_(run, { phase: 'VERIFY', status: 'VERIFYING' });
      return;
    case 'VERIFY': {
      var bad = resetVerify_(run);
      if (bad.length) throw resetError_('VERIFY_FAILED', bad.join('; '));
      resetFinish_(run, pr);
      return;
    }
    default:
      throw resetError_('BAD_PHASE', String(run.phase));
  }
}

/** Đếm lại tiến độ file từ ResetFiles (đúng cả khi lần trước bị ngắt giữa lô) */
function resetFilesRecount_(run, pr) {
  var list = findAll_('ResetFiles', 'reset_run_id', run.reset_run_id);
  pr.files = {
    total: list.length,
    done: list.filter(function (f) { return f.status !== 'PENDING'; }).length,
    failed: list.filter(function (f) { return f.status === 'FAILED'; }).length
  };
  return pr;
}

/**
 * Đổi thế hệ dữ liệu (21.5 bước 5): epoch mới (ghi vào đợt trước để chạy lại không đổi lần nữa), thu hồi mọi phiên
 * (phiên phục hồi của owner đợt này được gắn sang epoch mới), hủy thư chờ gửi và lô nhập dở của epoch cũ, ghi last_reset_at.
 */
function resetEpochPhase_(run) {
  withWriteLock_(function () {
    var r = readRowAt_('ResetRuns', run.__row);
    var after = r.after_epoch || uuid_();
    if (!r.after_epoch) { writeCells_('ResetRuns', run.__row, { after_epoch: after }); run.after_epoch = after; }
    if (prop_('DATASET_EPOCH') !== after) setProp_('DATASET_EPOCH', after);
    cache_().removeAll(['sys:props', 'sys:state']);
    var t = now_().getTime();
    readRows_('Sessions').forEach(function (s) {
      if (s.session_kind === 'RECOVERY' && s.user_id === r.requested_by && isSessionActive_(s, t)) {
        if (s.dataset_epoch !== after) { writeCells_('Sessions', s.__row, { dataset_epoch: after }); cache_().remove('ss:' + s.session_id); }
        return;
      }
      if (isSessionActive_(s, t)) revokeSessionRow_(s, 'DATASET_RESET');
    });
    readRows_('NotificationLogs').forEach(function (l) {
      if (l.status === 'QUEUED') writeCells_('NotificationLogs', l.__row, { status: 'SKIPPED', error_code: 'CANCELLED_BY_RESET' });
      else if (l.status === 'SENDING') writeCells_('NotificationLogs', l.__row, { status: 'UNKNOWN' });
    });
    readRows_('ImportBatches').forEach(function (b) {
      if (b.status !== 'COMMITTED' && b.status !== 'FAILED') writeCells_('ImportBatches', b.__row, { status: 'FAILED' });
    });
    var st = readState_();
    stateWrite_(st, { dataset_epoch: ['STRING', after], last_reset_at: ['DATETIME', isoVN_(now_())] }, r.requested_by);
  });
  cache_().removeAll(['sys:props', 'sys:state']);
}

/**
 * Một file (2.6, 1.4 §21.3): đưa về riêng tư trước (link cũ hết hiệu lực ở mọi chế độ), rồi giữ / thùng rác / xóa vĩnh viễn.
 * Không đổi chế độ ngầm: xóa vĩnh viễn lỗi thì báo lỗi, không tự đưa vào thùng rác.
 */
function resetProcessFile_(f, mode) {
  var file;
  try { file = DriveApp.getFileById(String(f.drive_file_id)); } catch (e) { return { status: 'MISSING', privacy_status: 'MISSING', error_code: '' }; }
  var out = { status: '', privacy_status: '', error_code: '' };
  try {
    if (file.getSharingAccess() !== DriveApp.Access.PRIVATE) file.setSharing(DriveApp.Access.PRIVATE, DriveApp.Permission.EDIT);
    out.privacy_status = file.getSharingAccess() === DriveApp.Access.PRIVATE ? 'PRIVATE' : 'FAILED';
  } catch (e) { out.privacy_status = 'FAILED'; }
  if (out.privacy_status === 'FAILED') out.error_code = 'SHARING_FAILED';
  if (mode === 'TRASH') {
    try { file.setTrashed(true); out.status = 'TRASHED'; } catch (e) { out.status = 'FAILED'; out.error_code = 'TRASH_FAILED'; }
    return out;
  }
  if (mode === 'DELETE') {
    try { Drive.Files.remove(String(f.drive_file_id)); out.status = 'DELETED'; } catch (e) { out.status = 'FAILED'; out.error_code = 'DELETE_FAILED'; }
    return out;
  }
  out.status = out.privacy_status === 'PRIVATE' ? 'KEPT' : 'FAILED';
  return out;
}

/** Xóa dữ liệu một bảng, giữ hàng tiêu đề/cột/định dạng (không xóa hàng để tránh lỗi "xóa hết hàng không cố định" của Sheets) */
function resetClearTable_(name) {
  return withWriteLock_(function () {
    var sheet = sh_(name);
    var last = sheet.getLastRow();
    if (last <= 1) { resetBumpTable_(name); return 0; }
    var keep = name === 'AuditLogs' ? readRows_('AuditLogs').filter(resetAuditKept_) : [];
    var width = Math.max(sheet.getLastColumn(), hdr_(name).cols.length, 1);
    sheet.getRange(2, 1, last - 1, width).clearContent();
    if (keep.length) insertRows_(name, keep.map(function (a) { var o = {}; Object.keys(a).forEach(function (k) { if (k !== '__row') o[k] = a[k]; }); return o; }));
    resetBumpTable_(name);
    return last - 1 - keep.length;
  });
}

/** Tăng phiên bản bảng: đệm bảng và sync.changes không trả bản cũ */
function resetBumpTable_(name) {
  var st = readState_();
  var rev = Number(stateGet_(st, 'sync_revision', 0)) + 1;
  var su = { sync_revision: ['INT', rev] };
  su['table_rev.' + name] = ['INT', rev];
  stateWrite_(st, su, SYSTEM_USER);
}

/** Phạm vi trỏ tới khu vực/hồ sơ cũ bị tắt (21.2); nạp lại mẫu báo cáo tích hợp */
function resetScopesPhase_(run) {
  withWriteLock_(function () {
    readRows_('UserScopes').forEach(function (s) {
      if (s.active && (s.location_id || s.module)) writeCells_('UserScopes', s.__row, { active: false, updated_at: isoVN_(now_()), updated_by: SYSTEM_USER });
    });
    readRows_('NotificationRecipients').forEach(function (r) {
      if (r.active && (r.location_scope || r.entity_scope)) writeCells_('NotificationRecipients', r.__row, { active: false });
    });
    resetBumpTable_('NotificationRecipients');
    seedReportDefinitions_();
  });
  adminFlushScopeCache_();
}

function adminFlushScopeCache_() {
  var keys = [];
  readRows_('Users').forEach(function (u) { keys.push('us:' + u.user_id, 'scope:' + u.user_id + ':' + (u.auth_version || 0)); });
  for (var i = 0; i < keys.length; i += 500) cache_().removeAll(keys.slice(i, i + 500));
}

/** Kiểm tra sau khi xóa (21.5 bước 7). Trả danh sách lỗi (rỗng = đạt). */
function resetVerify_(run) {
  dbReset_();
  var bad = [];
  resetTableOrder_().forEach(function (it) {
    var n = resetTableCount_(it.table);
    if (it.table === 'ReportDefinitions') {
      var nb = readRows_('ReportDefinitions').filter(function (d) { return d.builtin; }).length;
      if (n || nb !== RPT_BUILTIN_.length) bad.push('ReportDefinitions');
      return;
    }
    if (n) bad.push(it.table + ' ' + n);
  });
  var files = findAll_('ResetFiles', 'reset_run_id', run.reset_run_id);
  var pend = files.filter(function (f) { return f.status === 'PENDING'; }).length;
  if (pend) bad.push('ResetFiles PENDING ' + pend);
  if (prop_('DATASET_EPOCH') !== run.after_epoch) bad.push('DATASET_EPOCH');
  var owner = findOne_('Users', 'user_id', run.requested_by);
  if (!owner || !owner.active || !owner.is_system_owner || !hasFlag_(4, 'system', 'R')) bad.push('OWNER');
  var missing = sheetsForDot_(releasedDot_()).filter(function (n2) { return !book_(sheetSchema_(n2).book).getSheetByName(n2); });
  if (missing.length) bad.push('SHEETS ' + missing.join(','));
  var t = now_().getTime();
  var live = readRows_('Sessions').filter(function (s) { return isSessionActive_(s, t) && s.dataset_epoch !== run.after_epoch; }).length;
  if (live) bad.push('Sessions ' + live);
  return bad;
}

/** Hoàn tất (21.5 bước 8): biên nhận số lượng, bỏ chi tiết file tạm, tắt bảo trì, gỡ trigger */
function resetFinish_(run, pr) {
  var files = findAll_('ResetFiles', 'reset_run_id', run.reset_run_id);
  var byStatus = {};
  files.forEach(function (f) { byStatus[f.status] = (byStatus[f.status] || 0) + 1; });
  var receipt = {
    groups: {}, files: { total: files.length, kept: byStatus.KEPT || 0, trashed: byStatus.TRASHED || 0, deleted: byStatus.DELETED || 0,
      missing: byStatus.MISSING || 0, failed: byStatus.FAILED || 0,
      private_failed: files.filter(function (f) { return f.privacy_status === 'FAILED'; }).length, external: pr.external || 0 },
    backup_ref: run.backup_ref, file_mode: run.file_mode
  };
  Object.keys(pr.groups || {}).forEach(function (k) { receipt.groups[k] = pr.groups[k].done; });
  withWriteLock_(function () {
    // ResetFiles chỉ là danh sách tạm: bỏ ID/tên file cũ của đợt, giữ số lượng trong biên nhận
    var sheet = sh_('ResetFiles');
    var keepRows = readRows_('ResetFiles').filter(function (f) { return f.reset_run_id !== run.reset_run_id; });
    if (sheet.getLastRow() > 1) sheet.getRange(2, 1, sheet.getLastRow() - 1, Math.max(sheet.getLastColumn(), 1)).clearContent();
    if (keepRows.length) insertRows_('ResetFiles', keepRows.map(function (a) { var o = {}; Object.keys(a).forEach(function (k) { if (k !== '__row') o[k] = a[k]; }); return o; }));
    var nowIso = isoVN_(now_());
    writeCells_('ResetRuns', run.__row, {
      status: 'COMPLETED', phase: 'DONE', completed_at: nowIso, summary_counts_json: JSON.stringify(receipt), error_code: '', error_detail: '', updated_at: nowIso
    });
    writeAudit_({ user_id: run.requested_by, action: 'system.reset.complete', entity_type: 'SYSTEM', entity_id: run.reset_run_id,
      before_json: { dataset_epoch: run.before_epoch }, after_json: { dataset_epoch: run.after_epoch, backup_ref: run.backup_ref, file_mode: run.file_mode, counts: receipt.groups, files: receipt.files },
      auth_basis: 'OWNER' });
    setMaintenance_(false);
  });
  removeResetTrigger_();
  clearSysCaches_();
}

/* ---------------- Hiển thị ---------------- */

var RESET_STEPS_ = ['PREPARE', 'BACKUP', 'DELETE', 'VERIFY', 'DONE'];

function resetStepOf_(run) {
  if (run.status === 'COMPLETED') return 'DONE';
  if (run.status === 'CANCELLED') return 'PREPARE';
  var ph = run.phase;
  if (ph === 'BACKUP') return run.status === 'LOCKED' ? 'PREPARE' : 'BACKUP';
  if (ph === 'VERIFY') return 'VERIFY';
  if (ph === 'DONE') return 'DONE';
  return 'DELETE';
}

function resetRunView_(run) {
  if (!run) return null;
  var plan = resetJson_(run.plan_json, { groups: {}, files: {} });
  var pr = run.status === 'COMPLETED' ? null : resetProgress_(run);
  var receipt = run.status === 'COMPLETED' ? resetJson_(run.summary_counts_json, {}) : null;
  return {
    reset_run_id: run.reset_run_id, status: run.status, phase: run.phase, step: resetStepOf_(run), steps: RESET_STEPS_,
    requested_at: run.requested_at, requested_by_name: (userDirectory_()[run.requested_by] || {}).display_name || '',
    file_mode: run.file_mode, backup_ref: run.backup_ref || '', backup_verified_at: run.backup_verified_at || '',
    error_code: run.error_code || '', error_detail: run.error_code ? String(run.error_detail || '') : '',
    completed_at: run.completed_at || '', plan: plan, progress: pr, receipt: receipt,
    can_cancel: run.status === 'FAILED_NEEDS_RECOVERY' && run.phase === 'BACKUP',
    running: RESET_ACTIVE_[run.status] ? resetLeaseBusy_() : false
  };
}

/** SYS-RESET-01: thế hệ dữ liệu hiện tại, số bản ghi theo nhóm, lần sao lưu gần nhất, lần xóa sạch gần nhất */
function resetOverview_() {
  var st = readState_();
  var plan = resetPlan_();
  var runs = readRows_('ResetRuns').filter(function (r) { return r.status === 'COMPLETED'; });
  runs.sort(function (a, b) { return String(a.completed_at) < String(b.completed_at) ? 1 : -1; });
  var last = runs[0];
  return {
    epoch_short: String(plan.epoch || '').slice(0, 8), epoch_since: stateGet_(st, 'last_reset_at', '') || stateGet_(st, 'last_restore_at', ''),
    groups: plan.groups, files: plan.files,
    last_backup_at: stateGet_(st, 'last_backup_at', ''), last_backup_ref: stateGet_(st, 'last_backup_ref', ''), last_backup_status: stateGet_(st, 'last_backup_status', ''),
    last_reset: last ? { completed_at: last.completed_at, backup_ref: last.backup_ref, receipt: resetJson_(last.summary_counts_json, {}) } : null,
    delete_available: resetDeleteAvailable_()
  };
}

/* ---------------- Action ---------------- */

function systemResetPreview_(ctx) {
  var open = resetOpenRun_();
  if (open) return { open_run: resetRunView_(open) };
  var plan = resetPlan_();
  var hash = resetPlanHash_(plan);
  var nonce = uuid_() + uuid_().replace(/-/g, '');
  var exp = new Date(now_().getTime() + RESET_PREVIEW_MINUTES_ * 60000);
  var id = uuid_();
  withWriteLock_(function () {
    insertRows_('ResetRuns', [{
      reset_run_id: id, requested_by: ctx.user.user_id, requested_at: isoVN_(now_()), before_epoch: plan.epoch, after_epoch: '', scope_key: 'ME',
      file_mode: '', plan_hash: hash, confirmation_nonce_hash: b64url_(sha256_(nonce)), confirmation_expires_at: isoVN_(exp), backup_ref: '',
      backup_verified_at: '', status: 'PREVIEWED', phase: 'PREVIEW', cursor_json: '', summary_counts_json: '', completed_at: '', error_code: '',
      run_kind: 'RESET', source_backup_ref: '', plan_json: JSON.stringify(plan), recovery_session_id: '', error_detail: '', updated_at: isoVN_(now_())
    }]);
  });
  return {
    reset_run_id: id, plan_hash: hash, nonce: nonce, expires_at: isoVN_(exp), expires_in_seconds: RESET_PREVIEW_MINUTES_ * 60, plan: plan,
    file_modes: RESET_FILE_MODES_.map(function (m) { return { mode: m, available: m !== 'DELETE' || resetDeleteAvailable_() }; }),
    warehouse_connected: !!setting_('warehouse_connected'), confirm_text: RESET_CONFIRM_TEXT_
  };
}

/** Như app: nhận cả kiểu bỏ dấu cũ "XOÁ" và chữ thường; không dấu thì không nhận */
function resetConfirmOk_(s) {
  var t = String(s === undefined || s === null ? '' : s);
  try { t = t.normalize('NFC'); } catch (e) { /* V8 có normalize */ }
  t = t.trim().replace(/\s+/g, ' ').toUpperCase().replace(/OÁ/g, 'ÓA');
  return t === RESET_CONFIRM_TEXT_.normalize('NFC');
}

function systemResetRequest_(ctx) {
  var p = ctx.req.payload || {};
  var errs = [];
  if (RESET_FILE_MODES_.indexOf(p.file_mode) < 0) errs.push(fieldError_('file_mode', 'INVALID_VALUE'));
  else if (p.file_mode === 'DELETE' && !resetDeleteAvailable_()) errs.push(fieldError_('file_mode', 'FILE_MODE_UNAVAILABLE'));
  if (!resetConfirmOk_(p.confirm_text)) errs.push(fieldError_('confirm_text', 'CONFIRM_TEXT'));
  if (errs.length) throw validationError_(errs);
  var run = isUuidV4_(p.reset_run_id) ? resetRunRow_(p.reset_run_id) : null;
  if (!run || run.status !== 'PREVIEWED' || run.requested_by !== ctx.user.user_id) throw validationError_([fieldError_('reset_run_id', 'RESET_PLAN_EXPIRED')]);
  if (resetOpenRun_()) throw validationError_([fieldError_('reset_run_id', 'RESET_ACTIVE')]);
  var exp = parseTime_(run.confirmation_expires_at);
  if (!run.confirmation_nonce_hash || !exp || exp.getTime() <= now_().getTime()) throw validationError_([fieldError_('reset_run_id', 'RESET_PLAN_EXPIRED')]);
  if (!ctEqualStr_(b64url_(sha256_(String(p.nonce || ''))), run.confirmation_nonce_hash)) throw validationError_([fieldError_('nonce', 'RESET_PLAN_EXPIRED')]);
  // Bản kế hoạch phải khớp cả lúc xem trước (plan_hash client gửi) lẫn dữ liệu hiện tại (máy chủ đếm lại)
  var planNow = resetPlan_();
  if (p.plan_hash !== run.plan_hash || resetPlanHash_(planNow) !== run.plan_hash) throw validationError_([fieldError_('plan_hash', 'RESET_PLAN_CHANGED')]);
  var rec = null;
  checkOwnPin_(ctx, p.pin, 'RESET', function (u, eh) {
    if (u.failed_attempts || u.failed_window_started_at) {
      writeCells_('Users', u.__row, { failed_attempts: 0, failed_window_started_at: '' });
      cache_().remove('us:' + u.user_id);
    }
    logAttempt_('RESET', 'SUCCESS', eh, u, ctx.req);
    var r = readRowAt_('ResetRuns', run.__row);
    if (r.status !== 'PREVIEWED' || r.confirmation_nonce_hash !== run.confirmation_nonce_hash) throw validationError_([fieldError_('nonce', 'RESET_PLAN_EXPIRED')]);
    // Khóa vận hành (21.5 bước 3): dưới khóa ghi — mọi ghi trước đó đã xong; ghi sau đó gặp bảo trì
    setMaintenance_(true);
    rec = createSession_(u, 'RECOVERY', ctx.req);
    var nowIso = isoVN_(now_());
    writeCells_('ResetRuns', run.__row, {
      status: 'LOCKED', phase: 'BACKUP', requested_at: nowIso, before_epoch: sysProps_().dataset_epoch, file_mode: p.file_mode,
      confirmation_nonce_hash: '', recovery_session_id: rec.session_id, cursor_json: '{}', updated_at: nowIso
    });
    writeAudit_({ user_id: u.user_id, device_id: ctx.req.device_id, action: 'system.reset.request', entity_type: 'SYSTEM', entity_id: run.reset_run_id,
      before_json: { dataset_epoch: run.before_epoch }, after_json: { file_mode: p.file_mode, plan: planNow.groups, files: planNow.files },
      operation_id: ctx.req.operation_id || '', auth_basis: 'OWNER' });
  });
  installResetTrigger_();
  dbReset_();
  var fresh = resetRunRow_(run.reset_run_id);
  return {
    reset_run_id: run.reset_run_id, status: fresh.status, run: resetRunView_(fresh),
    recovery: { token: rec.token, expires_at: rec.expires_at, session_kind: 'RECOVERY' }
  };
}

function systemResetStatus_(ctx) {
  var p = ctx.req.payload || {};
  var out = { maintenance_mode: PropertiesService.getScriptProperties().getProperty('MAINTENANCE_MODE') === 'true' };
  var run = isUuidV4_(p.reset_run_id) ? resetRunRow_(p.reset_run_id) : resetOpenRun_();
  if (run && run.status !== 'PREVIEWED') {
    if (RESET_ACTIVE_[run.status] && p.advance !== false) {
      advanceReset_(run.reset_run_id, RESET_STEP_BUDGET_MS_);
      dbReset_();
      run = resetRunRow_(run.reset_run_id);
      out.maintenance_mode = PropertiesService.getScriptProperties().getProperty('MAINTENANCE_MODE') === 'true';
    }
    out.run = resetRunView_(run);
  }
  if (p.overview && ctx.session.session_kind !== 'RECOVERY') out.overview = resetOverview_();
  return out;
}

function systemResetResume_(ctx) {
  var p = ctx.req.payload || {};
  var mode = p.mode === 'CANCEL' ? 'CANCEL' : 'CONTINUE';
  var run = isUuidV4_(p.reset_run_id) ? resetRunRow_(p.reset_run_id) : null;
  if (!run) throw apiError_('NOT_FOUND');
  var stuck = RESET_ACTIVE_[run.status] && !resetLeaseBusy_();
  if (!(run.status === 'FAILED_NEEDS_RECOVERY' || (mode === 'CONTINUE' && stuck))) throw validationError_([fieldError_('reset_run_id', 'NOT_RESUMABLE')]);
  // Hủy chỉ khi chưa đổi epoch/xóa gì (21.5: hủy trước bước xóa có thể quay lại dữ liệu cũ)
  if (mode === 'CANCEL' && run.phase !== 'BACKUP') throw validationError_([fieldError_('reset_run_id', 'NOT_RESUMABLE')]);
  var rec = null;
  checkOwnPin_(ctx, p.pin, 'RESET', function (u, eh) {
    if (u.failed_attempts || u.failed_window_started_at) {
      writeCells_('Users', u.__row, { failed_attempts: 0, failed_window_started_at: '' });
      cache_().remove('us:' + u.user_id);
    }
    logAttempt_('RESET', 'SUCCESS', eh, u, ctx.req);
    var nowIso = isoVN_(now_());
    if (mode === 'CANCEL') {
      writeCells_('ResetRuns', run.__row, { status: 'CANCELLED', phase: 'CANCELLED', updated_at: nowIso });
      readRows_('Sessions').forEach(function (s) { if (s.session_kind === 'RECOVERY' && s.user_id === run.requested_by && !s.revoked_at) revokeSessionRow_(s, 'RESET_CANCELLED'); });
      setMaintenance_(false);
    } else {
      writeCells_('ResetRuns', run.__row, { status: resetStatusForPhase_(run.phase), error_code: '', error_detail: '', updated_at: nowIso });
      if (ctx.session.session_kind !== 'RECOVERY') rec = createSession_(u, 'RECOVERY', ctx.req);
    }
    writeAudit_({ user_id: u.user_id, device_id: ctx.req.device_id, action: 'system.reset.' + (mode === 'CANCEL' ? 'cancel' : 'resume'), entity_type: 'SYSTEM',
      entity_id: run.reset_run_id, before_json: { status: run.status, phase: run.phase, error_code: run.error_code }, after_json: null,
      operation_id: ctx.req.operation_id || '', auth_basis: 'OWNER' });
  });
  if (mode === 'CONTINUE') installResetTrigger_(); else removeResetTrigger_();
  dbReset_();
  var out = { run: resetRunView_(resetRunRow_(run.reset_run_id)) };
  if (rec) out.recovery = { token: rec.token, expires_at: rec.expires_at, session_kind: 'RECOVERY' };
  return out;
}

// ===== 35_report_pdf.js =====
/* 35_report_pdf: Logo công ty trên báo cáo và PDF có định dạng (bản 1.0.0-d4.11, người dùng yêu cầu 23/10/2026).
 * Logo công ty (không phải logo app 57 — logo 57 vẫn không ở báo cáo): tệp riêng tư trong thư mục dữ liệu app, Settings giữ ID tệp
 * và mã phiên bản; C4 tải lên/gỡ ở Quản trị. Không có logo → báo cáo như cũ, không chừa chỗ trống.
 * PDF dựng bằng Google Docs: đầu trang mỗi trang là logo; chân trang là tên báo cáo, số báo cáo, thời gian lập; trang đầu có khối tiêu đề
 * hai thứ tiếng, thông tin hai cột, tóm tắt dạng ô, biểu đồ thanh (ký tự khối, một màu, số ghi bằng chữ), bảng chi tiết (cột #, độ rộng
 * theo nội dung, số căn phải, hàng xen kẽ), chú thích, khối Người lập / Người duyệt.
 * Chỉ dùng phương thức DocumentApp có trong tài liệu Apps Script (setAttributes, editAsText, setAlignment, setColumnWidth…);
 * định dạng từng ô có hạn thời gian để PDF 500 dòng vẫn xong trước khi app hết chờ. */

var REPORT_LOGO_MAX_BYTES_ = 1048576;
var PDF_C_ = {
  navy: '#17324F', ink: '#1F2933', muted: '#5B6875', line: '#C9D3DF', head: '#E6ECF3', zebra: '#F7F9FC', tile: '#F1F5F9', white: '#FFFFFF',
  good: '#1E7B4A', bad: '#B42318', bar: '#2A78D6', elec: '#EB6834', water: '#2A78D6', elecLight: '#F6C1AA', waterLight: '#AFCBEF'
};
var PDF_STYLE_BUDGET_MS_ = 12000;
var PDF_LOGO_PX_H_ = 56;   // chiều cao logo đầu trang (Docs tính px ≈ 0,75 pt → khoảng 42 pt, 1,5 cm)
var PDF_MARGIN_ = 40;
var PDF_BAR_PT_ = 7;       // cỡ chữ của thanh; mỗi ký tự khối tính rộng tối đa 1 em (7 pt) để thanh dài nhất không tràn dòng dù phông thay thế rộng

/* ---------------- Logo báo cáo ---------------- */

/** Tệp logo đang dùng (Blob) hoặc null khi chưa có / tệp đã mất */
function reportLogoBlob_() {
  var id = setting_('report_logo_file_id');
  if (!id) return null;
  try {
    var f = DriveApp.getFileById(String(id));
    if (f.isTrashed()) return null;
    return f.getBlob();
  } catch (e) { return null; }
}

function reportLogoRev_() { return String(setting_('report_logo_rev') || ''); }

/** report.logo.get: logo cho bản xem trước và Excel trên máy ({rev: ''} khi chưa có) */
function reportLogoGet_(ctx) {
  var b = reportLogoBlob_();
  if (!b) return { rev: '' };
  return { rev: reportLogoRev_(), mime_type: b.getContentType(), content_b64: b64_(b.getBytes()) };
}

/**
 * report.logo.set {content_b64, mime_type: image/png | image/jpeg} hoặc {remove: true} — C4, PIN.
 * Ảnh ≤ 1 MB (app thu nhỏ trước khi gửi); cùng nội dung với logo đang dùng → trả luôn, không tạo tệp mới.
 */
function reportLogoSet_(ctx) {
  var p = ctx.req.payload || {};
  var by = ctx.user.user_id;
  var oldId = String(setting_('report_logo_file_id') || '');
  var before = { rev: reportLogoRev_() };
  var audit = function (after) {
    writeAudit_({ user_id: by, device_id: ctx.req.device_id, action: 'report.logo.set', entity_type: 'SETTINGS', entity_id: 'report_logo',
      before_json: before, after_json: after, operation_id: ctx.req.operation_id || '', auth_basis: authBasis_(ctx) });
  };
  if (p.remove === true) {
    withWriteLock_(function () {
      writeSetting_('report_logo_file_id', '', by);
      writeSetting_('report_logo_rev', '', by);
      audit({ rev: '' });
    });
    if (oldId) { try { trashQuietly_(DriveApp.getFileById(oldId)); } catch (e) { /* bỏ qua */ } }
    return { rev: '' };
  }
  var errs = [];
  if (p.mime_type !== 'image/png' && p.mime_type !== 'image/jpeg') errs.push(fieldError_('mime_type', 'FILE_TYPE'));
  if (typeof p.content_b64 !== 'string' || !p.content_b64) errs.push(fieldError_('content_b64', 'REQUIRED'));
  if (errs.length) throw validationError_(errs);
  var bytes;
  try { bytes = b64d_(p.content_b64); } catch (e) { throw validationError_([fieldError_('content_b64', 'INVALID_VALUE')]); }
  if (!bytes.length) throw validationError_([fieldError_('content_b64', 'REQUIRED')]);
  if (bytes.length > REPORT_LOGO_MAX_BYTES_) throw validationError_([fieldError_('content_b64', 'FILE_TOO_LARGE')]);
  if (!magicOk_(bytes, p.mime_type)) throw validationError_([fieldError_('mime_type', 'FILE_TYPE')]);
  var rev = b64url_(sha256_(bytes)).slice(0, 16);
  if (rev === before.rev && reportLogoBlob_()) return { rev: rev };
  var file = appFolder_().createFile(Utilities.newBlob(bytes, p.mime_type, 'report-logo.' + DOC_MIME_[p.mime_type].ext));
  try {
    withWriteLock_(function () {
      writeSetting_('report_logo_file_id', file.getId(), by);
      writeSetting_('report_logo_rev', rev, by);
      audit({ rev: rev, bytes: bytes.length, mime_type: p.mime_type });
    });
  } catch (e) {
    trashQuietly_(file);
    throw e;
  }
  if (oldId && oldId !== file.getId()) { try { trashQuietly_(DriveApp.getFileById(oldId)); } catch (e2) { /* bỏ qua */ } }
  return { rev: rev };
}

/* ---------------- Khung PDF dùng chung ---------------- */

function pdfAttrs_(o) {
  var A = DocumentApp.Attribute, out = {};
  Object.keys(o).forEach(function (k) { out[A[k]] = o[k]; });
  return out;
}

/** Chữ của cả phần tử: cỡ, màu, đậm, nghiêng (editAsText dùng được cho đoạn, ô, hàng, bảng) */
function pdfText_(el, size, color, bold, italic) {
  var t = el.editAsText();
  if (size) t.setFontSize(size);
  if (color) t.setForegroundColor(color);
  if (bold !== undefined && bold !== null) t.setBold(!!bold);
  if (italic !== undefined && italic !== null) t.setItalic(!!italic);
  return el;
}

function pdfPara_(p, o) {
  if (o.align) p.setAlignment(DocumentApp.HorizontalAlignment[o.align]);
  p.setSpacingBefore(o.before || 0);
  p.setSpacingAfter(o.after || 0);
  if (o.line) p.setLineSpacing(o.line);
  if (o.text !== undefined) pdfText_(p, o.size, o.color, o.bold, o.italic);
  return p;
}

/**
 * Tạo tài liệu tạm: khổ A4 (ngang khi `wide`), lề, đầu trang có logo (nếu có), chân trang một dòng.
 * Trả {doc, body, width (pt dùng được), t0, logo}.
 */
function pdfStart_(opts) {
  var doc = DocumentApp.create('ME_TMP_' + uuid_());
  var body = doc.getBody();
  var pageW = opts.wide ? 842 : 595, pageH = opts.wide ? 595 : 842;
  body.setPageWidth(pageW);
  body.setPageHeight(pageH);
  var logo = opts.logo === undefined ? reportLogoBlob_() : opts.logo;
  body.setMarginLeft(PDF_MARGIN_).setMarginRight(PDF_MARGIN_).setMarginBottom(44).setMarginTop(logo ? 84 : 40);
  if (logo) {
    try {
      var hs = doc.addHeader();
      var hp = hs.getParagraphs()[0] || hs.appendParagraph('');
      pdfPara_(hp, { align: 'LEFT' });
      var img = hp.appendInlineImage(logo);
      var w0 = img.getWidth(), h0 = img.getHeight();
      var h = PDF_LOGO_PX_H_, w = w0 && h0 ? Math.round(h * w0 / h0) : h;
      if (w > 220) { w = 220; h = w0 && h0 ? Math.round(w * h0 / w0) : h; }
      img.setWidth(w).setHeight(h);
    } catch (e) { logo = null; body.setMarginTop(40); }
  }
  if (opts.footer) {
    var fs = doc.addFooter();
    var fp = fs.getParagraphs()[0] || fs.appendParagraph('');
    fp.setText(opts.footer);
    pdfPara_(fp, { align: 'CENTER', text: true, size: 7, color: PDF_C_.muted });
  }
  return { doc: doc, body: body, width: pageW - 2 * PDF_MARGIN_, t0: Date.now(), logo: !!logo };
}

/** Lưu, đổi sang PDF, bỏ tệp tạm vào thùng rác */
function pdfFinish_(pd) {
  var id = pd.doc.getId();
  try {
    pd.doc.saveAndClose();
    return DriveApp.getFileById(id).getAs('application/pdf').getBytes();
  } finally {
    try { DriveApp.getFileById(id).setTrashed(true); } catch (e) { /* bỏ qua */ }
  }
}

function pdfTimeLeft_(pd) { return Date.now() - pd.t0 < PDF_STYLE_BUDGET_MS_; }

/** Khối tiêu đề: dòng Việt to, dòng Trung dưới, căn giữa (dùng đoạn trống đầu thân tài liệu) */
function pdfTitle_(pd, vi, zh) {
  var p0 = pd.body.getParagraphs()[0];
  p0.setText(vi || zh || '');
  pdfPara_(p0, { align: 'CENTER', after: zh && vi ? 2 : 10, text: true, size: 16, color: PDF_C_.navy, bold: true });
  if (zh && vi) pdfPara_(pd.body.appendParagraph(zh), { align: 'CENTER', after: 10, text: true, size: 12, color: PDF_C_.navy, bold: true });
}

function pdfHeading_(pd, text, before) {
  return pdfPara_(pd.body.appendParagraph(text), { before: before === undefined ? 12 : before, after: 4, text: true, size: 10, color: PDF_C_.navy, bold: true });
}

function pdfNote_(pd, text) {
  return pdfPara_(pd.body.appendParagraph(text), { before: 2, text: true, size: 8, color: PDF_C_.muted, italic: true });
}

/** Bảng không viền, đệm ô nhỏ */
function pdfPlain_(t) {
  t.setBorderWidth(0);
  return t;
}

function pdfCellPad_(c, v, h) {
  c.setPaddingTop(v).setPaddingBottom(v).setPaddingLeft(h).setPaddingRight(h);
  return c;
}

/** Căn mọi đoạn trong ô */
function pdfCellAlign_(c, align) {
  var A = DocumentApp.HorizontalAlignment[align];
  for (var i = 0; i < c.getNumChildren(); i++) {
    var ch = c.getChild(i);
    if (ch.getType() === DocumentApp.ElementType.PARAGRAPH) ch.asParagraph().setAlignment(A);
  }
}

/** Thông tin hai cột: trái (kỳ, khu vực, lọc), phải (số báo cáo, ngày lập, người lập — căn phải). lines = [[nhãn, giá trị]] */
function pdfMeta_(pd, left, right) {
  var fmt = function (l) { return l[1] ? l[0] + ': ' + l[1] : l[0]; };
  var t = pdfPlain_(pd.body.appendTable([[left.map(fmt).join('\n'), right.map(fmt).join('\n')]]));
  t.setColumnWidth(0, Math.round(pd.width * 0.56)).setColumnWidth(1, pd.width - Math.round(pd.width * 0.56));
  pdfText_(t, 9, PDF_C_.ink);
  var r = t.getRow(0);
  pdfCellPad_(r.getCell(0), 2, 0);
  pdfCellPad_(r.getCell(1), 2, 0);
  pdfCellAlign_(r.getCell(1), 'RIGHT');
  return t;
}

/** Ô số tóm tắt: tối đa 4 ô một hàng; mỗi ô nhãn nhỏ xám + số đậm. items = [{label, value}] */
function pdfTiles_(pd, items) {
  if (!items.length) return null;
  var per = 4; // cố định 4 cột: ít ô thì ô vẫn cỡ vừa, phần còn lại trống (không nền)
  var rows = [];
  for (var i = 0; i < items.length; i += per) {
    var row = [];
    for (var j = 0; j < per; j++) row.push('');
    rows.push(row);
  }
  var t = pd.body.appendTable(rows);
  t.setBorderWidth(3).setBorderColor(PDF_C_.white);
  var w = Math.floor(pd.width / per);
  for (var k = 0; k < per; k++) t.setColumnWidth(k, w);
  items.forEach(function (it, n) {
    var c = t.getCell(Math.floor(n / per), n % per);
    c.setBackgroundColor(PDF_C_.tile);
    pdfCellPad_(c, 5, 7);
    var p0 = c.getChild(0).asParagraph();
    p0.setText(it.label);
    pdfText_(p0, 8, PDF_C_.muted, false);
    var p1 = c.appendParagraph(it.value);
    pdfPara_(p1, { before: 2, text: true, size: it.value.length > 18 ? 10 : 13, color: PDF_C_.navy, bold: true });
    if (it.note) pdfPara_(c.appendParagraph(it.note), { text: true, size: 7, color: PDF_C_.muted, bold: false });
  });
  return t;
}

/**
 * Biểu đồ thanh ngang bằng ký tự khối (chữ của tài liệu, in nét): [nhãn | thanh | số]. Một chuỗi → một màu, không chú giải;
 * số ghi bằng màu chữ thường. items = [{label, value (null = không vẽ), text (chữ ở cột số), light (thanh nhạt: thiếu một phần)}]
 */
function pdfBars_(pd, title, items, color, lightColor) {
  if (!items.length) return;
  pdfHeading_(pd, title, 10);
  var max = 0;
  items.forEach(function (it) { if (it.value !== null && it.value > max) max = it.value; });
  var wl = Math.round(pd.width * 0.3), wv = Math.round(pd.width * 0.2), wb = pd.width - wl - wv;
  var maxChars = Math.max(10, Math.min(60, Math.floor((wb - 8) / PDF_BAR_PT_)));
  var cells = items.map(function (it) {
    var n = it.value === null || !(max > 0) ? 0 : Math.max(it.value > 0 ? 1 : 0, Math.round(it.value / max * maxChars));
    return [it.label, n ? new Array(n + 1).join('\u2588') : '', it.text];
  });
  var t = pdfPlain_(pd.body.appendTable(cells));
  t.setColumnWidth(0, wl).setColumnWidth(1, wb).setColumnWidth(2, wv);
  pdfText_(t, 8, PDF_C_.ink);
  items.forEach(function (it, i) {
    var r = t.getRow(i);
    for (var c = 0; c < 3; c++) pdfCellPad_(r.getCell(c), 1, 2);
    var bar = r.getCell(1);
    if (bar.getText()) pdfText_(bar, PDF_BAR_PT_, it.light ? lightColor || color : color);
    if (it.value === null) pdfText_(r.getCell(2), 8, PDF_C_.muted, false, true);
  });
}

/**
 * Độ rộng cột (pt) theo nội dung: ước lượng số ký tự (dòng dài nhất trong ô, lấy mức 90 % các dòng để một ô quá dài không chiếm hết),
 * cột số/ngày hẹp, cột chữ có trần; thiếu chỗ thì co theo tỷ lệ nhưng không nhỏ hơn 26 pt; thừa chỗ thì giãn cho kín khổ.
 */
function pdfColWidths_(head, rows, types, avail, fixed0) {
  var n = head.length;
  var longest = function (s) { return String(s || '').split('\n').reduce(function (m, x) { return Math.max(m, x.length); }, 0); };
  var ideal = [];
  for (var c = 0; c < n; c++) {
    if (fixed0 && c === 0) { ideal.push(fixed0); continue; }
    var lens = rows.map(function (r) { return longest(r[c]); }).sort(function (a, b) { return a - b; });
    var p90 = lens.length ? lens[Math.min(lens.length - 1, Math.floor(lens.length * 0.9))] : 0;
    var hl = longest(head[c]);
    var ty = types[c] || 'text';
    var cap = ty === 'num' || ty === 'money' || ty === 'date' ? 16 : (ty === 'time' ? 16 : (ty === 'code' ? 18 : 42));
    var chars = Math.min(cap, Math.max(p90, Math.min(hl, cap), ty === 'num' ? 4 : (ty === 'code' ? 7 : 6)));
    ideal.push(chars * 5 + 12); // ~5 pt mỗi ký tự ở cỡ 7–8, đệm ô 2 × 5 pt + 2
  }
  var free = avail - (fixed0 || 0);
  var flex = ideal.slice(fixed0 ? 1 : 0);
  var sum = flex.reduce(function (a, b) { return a + b; }, 0);
  var out = flex.map(function (w) { return w * free / sum; });
  if (sum > free) {
    // Co: cột nhỏ hơn 26 pt nâng lên 26, phần thiếu trừ đều vào các cột còn lại theo tỷ lệ
    for (var k = 0; k < 4; k++) {
      var under = 0, rest = 0;
      out.forEach(function (w) { if (w < 26) under += 26 - w; else rest += w; });
      if (!under) break;
      if (!(rest > 0)) break;
      out = out.map(function (w) { return w < 26 ? 26 : w - under * w / rest; });
    }
  }
  out = out.map(function (w) { return Math.floor(w); });
  return fixed0 ? [fixed0].concat(out) : out;
}

/**
 * Bảng dữ liệu có định dạng: tiêu đề nền xám nhạt chữ đậm, viền mảnh, cột # (khi `numbered`), số/tiền căn phải, ngày căn giữa,
 * hàng xen kẽ (≤ 300 dòng). types[i]: num | money | date | time | code | text. cellColor(r, c) → màu chữ riêng của ô (vd Đạt/Không đạt).
 */
function pdfTable_(pd, head, rows, types, opts) {
  opts = opts || {};
  var numbered = !!opts.numbered;
  var h = numbered ? ['#'].concat(head) : head.slice();
  var ty = numbered ? ['num'].concat(types) : types.slice();
  var data = rows.map(function (r, i) { return numbered ? [String(i + 1)].concat(r) : r; });
  if (!data.length) data = [h.map(function (x, i) { return i === (numbered ? 1 : 0) ? (opts.empty || lab_('field.no_records')) : ''; })];
  var t = pd.body.appendTable([h].concat(data));
  t.setBorderWidth(1).setBorderColor(PDF_C_.line);
  var widths = pdfColWidths_(h, data, ty, pd.width, numbered ? 24 : 0);
  widths.forEach(function (w, i) { t.setColumnWidth(i, w); });
  var fs = opts.fontSize || (h.length > 9 ? 7 : 8);
  pdfText_(t, fs, PDF_C_.ink);
  var hr = t.getRow(0);
  pdfText_(hr, fs, PDF_C_.navy, true);
  for (var c = 0; c < h.length; c++) {
    var hc = hr.getCell(c);
    hc.setBackgroundColor(PDF_C_.head);
    hc.setVerticalAlignment(DocumentApp.VerticalAlignment.CENTER);
    if (ty[c] === 'num' || ty[c] === 'money') pdfCellAlign_(hc, 'RIGHT');
    else if (ty[c] === 'date') pdfCellAlign_(hc, 'CENTER');
  }
  if (!rows.length) { pdfText_(t.getRow(1), fs, PDF_C_.muted, false, true); return t; }
  var zebra = data.length <= 300;
  var alignCols = [];
  ty.forEach(function (x, i) { if (x === 'num' || x === 'money') alignCols.push([i, 'RIGHT']); else if (x === 'date') alignCols.push([i, 'CENTER']); });
  for (var r = 1; r <= data.length; r++) {
    if (!pdfTimeLeft_(pd)) break;
    var row = t.getRow(r);
    if (numbered) pdfText_(row.getCell(0), fs, PDF_C_.muted);
    if (zebra && r % 2 === 0) for (var z = 0; z < h.length; z++) row.getCell(z).setBackgroundColor(PDF_C_.zebra);
    for (var a = 0; a < alignCols.length; a++) {
      var cell = row.getCell(alignCols[a][0]);
      if (cell.getNumChildren()) cell.getChild(0).asParagraph().setAlignment(DocumentApp.HorizontalAlignment[alignCols[a][1]]);
    }
    if (opts.cellColor) {
      for (var cc = numbered ? 1 : 0; cc < h.length; cc++) {
        var col = opts.cellColor(r - 1, numbered ? cc - 1 : cc);
        if (col) pdfText_(row.getCell(cc), fs, col, true);
      }
    }
  }
  return t;
}

/** Bảng nhãn – giá trị (hồ sơ, phiếu): cột nhãn nền nhạt */
function pdfKv_(pd, kv) {
  var data = kv.length ? kv : [[lab_('field.no_records'), '']];
  var t = pd.body.appendTable(data);
  t.setBorderWidth(1).setBorderColor(PDF_C_.line);
  var wl = Math.round(pd.width * 0.32);
  t.setColumnWidth(0, wl).setColumnWidth(1, pd.width - wl);
  pdfText_(t, 9, PDF_C_.ink);
  for (var i = 0; i < data.length; i++) {
    if (!pdfTimeLeft_(pd)) break;
    var c = t.getRow(i).getCell(0);
    c.setBackgroundColor(PDF_C_.tile);
    pdfText_(c, 8, PDF_C_.muted, true);
  }
  return t;
}

/** Khối ký: Người lập (có tên người tạo khi biết) · Người duyệt; dòng hướng dẫn ký, khoảng trống để ký */
function pdfSign_(pd, preparedName) {
  var spacer = pd.body.appendParagraph('');
  pdfPara_(spacer, { before: 14 });
  var hint = lab_('rpt.sign_hint');
  var t = pdfPlain_(pd.body.appendTable([
    [lab_('rpt.prepared_by'), lab_('rpt.approved_by')],
    [hint, hint],
    ['\n\n\n', '\n\n\n'],
    [preparedName || '', '']
  ]));
  var half = Math.floor(pd.width / 2);
  t.setColumnWidth(0, half).setColumnWidth(1, pd.width - half);
  pdfText_(t, 9, PDF_C_.ink);
  pdfText_(t.getRow(0), 9, PDF_C_.navy, true);
  pdfText_(t.getRow(1), 7, PDF_C_.muted, false, true);
  pdfText_(t.getRow(3), 9, PDF_C_.ink, true);
  for (var r = 0; r < 4; r++) for (var c = 0; c < 2; c++) { pdfCellPad_(t.getRow(r).getCell(c), 1, 4); pdfCellAlign_(t.getRow(r).getCell(c), 'CENTER'); }
  return t;
}

/* ---------------- PDF báo cáo (8 mẫu, bản đã lưu) ---------------- */

function pdfColType_(c) {
  if (c.type === 'num' || c.type === 'money' || c.type === 'date' || c.type === 'time' || c.type === 'code') return c.type;
  return 'text';
}

/** Nhãn kỳ ngắn cho biểu đồ (tháng: mm/yyyy; ngày: dd/mm/yyyy; khoảng: dd/mm – dd/mm/yyyy) */
function pdfPeriodLabel_(type, a, b) {
  if (type === 'MONTH') return a.slice(5, 7) + '/' + a.slice(0, 4);
  if (a === b) return fmtDateVN_(a);
  return a.slice(8, 10) + '/' + a.slice(5, 7) + ' – ' + fmtDateVN_(b);
}

/** Biểu đồ của báo cáo: đếm theo trạng thái (một màu); điện, nước theo kỳ (mỗi loại một biểu đồ, không chung trục) */
function reportPdfCharts_(pd, data) {
  var ch = data.chart;
  if (!ch) return;
  if (ch.series && ch.series.length) {
    pdfBars_(pd, lab_('rpt.chart'), ch.series.map(function (s) {
      return { label: lab_(s.enumKey + '.' + s.key), value: Number(s.value) || 0, text: fmtNumSrv_(s.value) };
    }), PDF_C_.bar);
    return;
  }
  if (!ch.line || !ch.line.length) return;
  var pt = (data.period && data.period.period_type) || 'MONTH';
  ['ELECTRICITY', 'WATER'].forEach(function (ut) {
    if (!ch.line.some(function (p) { return p.totals && p.totals[ut]; })) return;
    var unit = UTILITY_UNIT_[ut];
    var items = ch.line.map(function (p) {
      var x = (p.totals || {})[ut];
      var label = pdfPeriodLabel_(pt, p.period_start, p.period_end);
      if (!x || !x.ok) return { label: label, value: null, text: lab_(x && x.open ? 'utility_status.OPEN_PERIOD' : 'utility_status.NO_READING') };
      var part = x.open || x.partial;
      return { label: label, value: x.consumption, light: part, text: fmtNumSrv_(x.consumption) + ' ' + unit + (part ? ' (' + lab_(x.open ? 'utility_status.OPEN_PERIOD' : 'ut.partial') + ')' : '') };
    });
    pdfBars_(pd, lab_(ut === 'WATER' ? 'ut.chart_water' : 'ut.chart_elec') + ' (' + unit + ')', items,
      ut === 'WATER' ? PDF_C_.water : PDF_C_.elec, ut === 'WATER' ? PDF_C_.waterLight : PDF_C_.elecLight);
  });
}

/**
 * Dựng PDF một báo cáo (dữ liệu của reportCompute_ hoặc bản chụp đã lưu). Không cụm nhận diện app (1.4 §3.5); logo là logo công ty
 * do quản trị tải lên (nếu có).
 */
function reportPdf_(data) {
  var cols = data.columns || [];
  var titleVi = data.title_vi || '', titleZh = data.title_zh || '';
  var gen = fmtTimeSrv_(data.generated_at);
  var footer = [titleVi || titleZh, data.report_run_code ? lab_('rpt.number') + ': ' + data.report_run_code : '', lab_('rpt.generated_at') + ': ' + gen]
    .filter(Boolean).join('   ·   ');
  var pd = pdfStart_({ wide: cols.length > 7, footer: footer });
  try {
    pdfTitle_(pd, titleVi, titleZh);
    var left = reportFilterLines_(data).map(function (x) { var i = x.indexOf(': '); return i > 0 ? [x.slice(0, i), x.slice(i + 2)] : [x, '']; });
    var right = [];
    if (data.report_run_code) right.push([lab_('rpt.number'), data.report_run_code]);
    right.push([lab_('rpt.generated_at'), gen]);
    right.push([lab_('rpt.prepared_by'), data.generated_by_name || '']);
    pdfMeta_(pd, left, right);
    var tiles = (data.summary || []).map(function (s) {
      var label = s.enumKey ? lab_(s.enumKey + '.' + s.enum) + (s.label_vi ? ' — ' + s.label_vi + ' · ' + s.label_zh : '') : s.label_vi + ' · ' + s.label_zh;
      var val = s.money ? fmtMoneySrv_(s.value, s.currency) : (s.value === null ? lab_(s.na_key || 'field.not_set') : fmtNumSrv_(s.value) + (s.unit ? (s.unit === '%' ? '%' : ' ' + s.unit) : ''));
      return { label: label, value: val, note: s.partial ? lab_('ut.partial') : '' };
    });
    if (tiles.length) { pdfHeading_(pd, lab_('rpt.summary'), 10); pdfTiles_(pd, tiles); }
    reportPdfCharts_(pd, data);
    pdfHeading_(pd, lab_('rpt.detail') + '  ·  ' + lab_('rpt.rows_n', { N: fmtNumSrv_(data.total_rows === undefined ? data.rows.length : data.total_rows) }), 12);
    var head = cols.map(function (c) { return c.label_vi + '\n' + c.label_zh; });
    var rows = data.rows.map(function (r) { return cols.map(function (c) { return reportCellText_(c, r); }); });
    pdfTable_(pd, head, rows, cols.map(pdfColType_), { numbered: true });
    if (data.cost_hidden) pdfNote_(pd, lab_('cost.hidden'));
    (data.notes || []).forEach(function (n) { pdfNote_(pd, lab_(n)); });
    if (data.truncated) pdfNote_(pd, lab_('rpt.truncated', { N: data.total_rows }));
    pdfSign_(pd, data.generated_by_name || '');
  } catch (e) {
    try { DriveApp.getFileById(pd.doc.getId()).setTrashed(true); } catch (e2) { /* bỏ qua */ }
    throw e;
  }
  return pdfFinish_(pd);
}

/**
 * PDF hồ sơ/phiếu (export.pdf): title [vi, zh], kv [[nhãn, giá trị]], tables [{title, head, rows, types, cellColor}], costNote,
 * code (mã hồ sơ cho chân trang), preparedName.
 */
function entityPdf_(o) {
  var gen = fmtTimeSrv_(isoVN_(now_()));
  var footer = [o.title[0] + (o.code ? ' ' + o.code : ''), lab_('rpt.generated_at') + ': ' + gen].join('   ·   ');
  var pd = pdfStart_({ wide: false, footer: footer });
  try {
    pdfTitle_(pd, o.title[0], o.title[1]);
    pdfMeta_(pd, o.code ? [[lab_('col.code'), o.code]] : [], [[lab_('rpt.generated_at'), gen], [lab_('rpt.prepared_by'), o.preparedName || '']]);
    pdfHeading_(pd, lab_('rpt.info'), 10);
    pdfKv_(pd, o.kv);
    (o.tables || []).forEach(function (t) {
      pdfHeading_(pd, t.title, 12);
      pdfTable_(pd, t.head, t.rows, t.types, { numbered: false, cellColor: t.cellColor, fontSize: 8 });
    });
    if (o.costNote) pdfNote_(pd, lab_('cost.hidden'));
    pdfSign_(pd, o.preparedName || '');
  } catch (e) {
    try { DriveApp.getFileById(pd.doc.getId()).setTrashed(true); } catch (e2) { /* bỏ qua */ }
    throw e;
  }
  return pdfFinish_(pd);
}

// ===== 36_feed.js =====
/* 36_feed: cửa chỉ-đọc danh sách thiết bị cho app Checksheet (1.0.0-d4.12, người dùng yêu cầu 28/10/2026).
 * Không cần phiên; khóa bằng mã kết nối FEED_KEY_CS trong Thuộc tính tập lệnh (tạo bằng adminCreateFeedKey, chép sang app
 * Checksheet). Chỉ trả khu vực và thiết bị (mã, tên, khu vực, trạng thái, loại, model, mã QR) — không có giá, hợp đồng, người dùng
 * hay dữ liệu khác. Checksheet lấy một chiều mỗi giờ; thiết bị vẫn chỉ sửa ở M&E. */

var FEED_MIN_KEY_ = 24;

/** Mốc phiên bản nguồn: đổi khi Thiết bị, Khu vực, Danh mục tra cứu hoặc mã QR đổi (Checksheet không đổi thì khỏi tải lại) */
function feedRev_(st) {
  return ['Equipment', 'Locations', 'LookupValues', 'QrRegistry'].map(function (n) { return Number(stateGet_(st, 'table_rev.' + n, 0)); }).join('.') +
    ':' + String(sysProps_().dataset_epoch || '').slice(0, 8);
}

/** feed.equipment {key, since_rev?, client?} — public; sai mã → FORBIDDEN */
function feedEquipment_(req) {
  var p = req.payload || {};
  var want = prop_('FEED_KEY_CS') || '';
  if (want.length < FEED_MIN_KEY_ || !ctEqualStr_(String(p.key || ''), want)) throw apiError_('FORBIDDEN');
  var st = readState_();
  var rev = feedRev_(st);
  if (p.since_rev && String(p.since_rev) === rev) return { unchanged: true, rev: rev };
  var tc = tableCache_(['Equipment', 'Locations', 'LookupValues', 'QrRegistry'], st);
  var cat = {};
  tc.rows('LookupValues').forEach(function (v) { if (v.group_key === 'EQUIPMENT_CATEGORY') cat[v.value_id] = v; });
  var qr = {};
  tc.rows('QrRegistry').forEach(function (q) { if (q.entity_type === 'EQUIPMENT' && q.active) qr[q.entity_id] = q.qr_key; });
  var locations = tc.rows('Locations').map(function (l) {
    return {
      location_id: l.location_id, location_code: l.location_code, name_vi: l.name_vi, name_zh: l.name_zh,
      parent_location_id: l.parent_location_id || '', active: l.active !== false && !l.archived_at
    };
  });
  var equipment = tc.rows('Equipment').map(function (e) {
    var c = cat[e.category_id];
    return {
      equipment_id: e.equipment_id, equipment_code: e.equipment_code, name_vi: e.name_vi, name_zh: e.name_zh,
      location_id: e.location_id || '', status: e.status || '', category_vi: c ? c.name_vi : '', category_zh: c ? c.name_zh : '',
      model: e.model || '', qr_key: qr[e.equipment_id] || '', archived: !!e.archived_at
    };
  });
  return { rev: rev, locations: locations, equipment: equipment, server_time: isoVN_(now_()) };
}

/**
 * Chạy từ trình soạn: tạo mã kết nối cho app Checksheet (một lần) và in ra nhật ký để chép sang
 * Checksheet → Tài khoản → Quản trị → Kết nối M&E. Đã có mã thì in lại mã cũ (không đổi, Checksheet vẫn chạy).
 * Muốn đổi mã (lộ mã): xóa FEED_KEY_CS trong Thuộc tính tập lệnh rồi chạy lại, nhập mã mới bên Checksheet.
 */
function adminCreateFeedKey() {
  var props = PropertiesService.getScriptProperties();
  var k = props.getProperty('FEED_KEY_CS');
  if (!k) {
    k = b64url_(randomSecret32_());
    props.setProperty('FEED_KEY_CS', k);
    log_('Đã tạo mã kết nối Checksheet: ' + k);
  } else {
    log_('Mã kết nối Checksheet (đang dùng): ' + k);
  }
  log_('Chép mã này và link /exec của máy chủ M&E này sang app Checksheet → Tài khoản → Quản trị → Kết nối M&E.');
}

// ===== 37_plan_group.js =====
/* 37_plan_group: kế hoạch bảo trì cho cả nhóm máy cùng loại (d4.18, Bước 2 kế hoạch năm — người dùng yêu cầu 29/10/2026).
 * Mỗi máy vẫn một kế hoạch riêng (phiếu, QR, lịch sử, giờ chạy theo máy); các kế hoạch tạo cùng một lượt mang chung plan_group_id
 * để sửa cả nhóm. maintenance.plan.group tạo kế hoạch cho nhiều máy (≤ 100) trong một thao tác, dùng cả khi thêm máy mới vào nhóm có
 * sẵn; ngày mốc từng máy do app tính (rải lịch cách N ngày). maintenance.plan.group_edit đổi tên việc, số chu kỳ (giữ kiểu chu kỳ),
 * checklist, người làm, ưu tiên, thời gian dự kiến, lưu ý an toàn, ngừng/chạy lại cho các kế hoạch được chọn trong nhóm. Kết quả trả
 * gọn (mã + phiên bản): bản ghi đầy đủ về app qua đồng bộ (ô Operations.result_json tối đa 50 000 ký tự). */

var PLAN_GROUP_MAX_ = 100;

/** Trường dùng chung của nhóm (giống maintenance.plan.edit): lỗi đẩy vào errs */
function planGroupCommonErrors_(p, errs, itype) {
  var ival = Number(p.interval_value);
  var maxV = itype === 'MONTH' ? 120 : (itype === 'DAY' ? 3650 : 100000);
  if (p.interval_value !== undefined && !(ival >= 1 && ival <= maxV && Math.floor(ival) === ival)) {
    errs.push(fieldError_('interval_value', p.interval_value === '' || p.interval_value === null ? 'REQUIRED' : 'INVALID_VALUE'));
  }
  if (p.priority !== undefined && PRIORITIES_.indexOf(p.priority) < 0) errs.push(fieldError_('priority', 'INVALID_VALUE'));
  if (p.estimated_minutes !== undefined && p.estimated_minutes !== '' && p.estimated_minutes !== null) {
    var em = Number(p.estimated_minutes);
    if (!(em >= 0 && em <= 100000 && Math.floor(em) === em)) errs.push(fieldError_('estimated_minutes', 'INVALID_VALUE'));
  }
  if (p.checklist_template_id !== undefined && p.checklist_template_id !== '' && !isUuidV4_(p.checklist_template_id)) errs.push(fieldError_('checklist_template_id', 'ID_INVALID'));
  if (p.assignee_user_id !== undefined && p.assignee_user_id !== '' && !isUuidV4_(p.assignee_user_id)) errs.push(fieldError_('assignee_user_id', 'ID_INVALID'));
}

/** Kế hoạch mới có thể tới hạn ngay (đỡ đọc phiếu/thiết bị cho từng máy khi tạo cả nhóm) */
function planMayBeDue_(row, latest) {
  if (row.interval_type === 'OPERATING_HOURS') return !!latest && Number(row.operating_hours_target) > 0 && Number(latest.cumulative_hours) >= Number(row.operating_hours_target);
  if (!isDateStr_(row.next_due_date)) return false;
  var ahead = Number(setting_('wo_generate_days_ahead'));
  if (!(ahead >= 0)) ahead = 7;
  return daysRemaining_(row.next_due_date, todayVN_()) <= ahead;
}

/**
 * maintenance.plan.group {plan_group_id, plans: [{plan_id, equipment_id, anchor_date, operating_hours_target?}], title_vi/zh,
 * interval_type, interval_value, checklist_template_id, assignee_user_id, priority, estimated_minutes, safety_note_vi/zh}
 * Tạo mỗi máy một kế hoạch; plan_group_id có sẵn = thêm máy vào nhóm (máy đã có kế hoạch trong nhóm → ALREADY_IN_GROUP).
 * Theo giờ chạy: mốc mặc định = giờ mới nhất + chu kỳ (không có số đọc thì phải nhập mốc cho máy đó). Tới hạn thì sinh phiếu luôn.
 */
function maintenancePlanGroup_(ctx) {
  var p = ctx.req.payload || {};
  var errs = [];
  if (!isUuidV4_(p.plan_group_id)) errs.push(fieldError_('plan_group_id', 'ID_INVALID'));
  var items = Array.isArray(p.plans) ? p.plans : [];
  if (!items.length) errs.push(fieldError_('plans', 'REQUIRED'));
  else if (items.length > PLAN_GROUP_MAX_) errs.push(fieldError_('plans', 'GROUP_TOO_LARGE'));
  requireOneLang_(errs, p, null, 'title');
  var itype = p.interval_type;
  if (PLAN_INTERVAL_TYPES_.indexOf(itype) < 0) errs.push(fieldError_('interval_type', itype ? 'INVALID_VALUE' : 'REQUIRED'));
  if (p.interval_value === undefined) errs.push(fieldError_('interval_value', 'REQUIRED'));
  planGroupCommonErrors_(p, errs, itype);
  if (Number(ctx.req.expected_version || 0) !== 0) errs.push(fieldError_('expected_version', 'INVALID_VALUE'));

/** P-10: đếm thiết bị thử và kiểm trùng mã */
function pocStats_(ctx) {
  var prefix = trimStr_((ctx.req.payload || {}).name_prefix) || 'P10-';
  var rows = readRows_('Equipment');
  var codes = {}, dupCodes = [], ids = {}, dupIds = [];
  rows.forEach(function (r) {

      if (r.status === st[r.reading_id]) return;
      var r2 = clone_(r); delete r2.__row;
      r2.status = st[r.reading_id];
      cUpdate_(ctx, r2);
      writes.push({ sheet: 'MeterReadings', mode: 'update', row: r2 });
      changed.push(r2.reading_id);
    });
  });
  return changed;
}


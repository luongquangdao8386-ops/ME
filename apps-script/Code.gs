    out[k] = { module: ds.module, filters: ds.filters, chart: ds.chart, columns: ds.columns.filter(function (c) { return !c.cost || cost; }).map(function (c) { return { key: c.key, type: c.type, label_vi: c.vi, label_zh: c.zh, cost: !!c.cost }; }) };
  });
